# Copy to backend/.env and fill in. Never commit backend/.env.

# Server port (no default in code; must be set)
PORT=4000
NODE_ENV=development

# MongoDB connection string
DB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>
# JWT signing secret: long random string
JWT_SECRET=change_me

# Number of reverse-proxy hops in front of the API (omit when none); used by rate limits and login risk checks
# TRUST_PROXY=1

# Requests per 15 minutes per client address across /api (default 600)
# RATE_LIMIT_MAX=600

# Audio streaming requests per 15 minutes per client address (default 6000); audio is not counted in RATE_LIMIT_MAX
# AUDIO_RATE_LIMIT_MAX=6000

# Cloudflare Turnstile secret key. Needed in production: without it a required login captcha always fails
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Comma-separated CORS origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Seeded super-admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_NAME=Admin
DEFAULT_ADMIN_PHOTO_LINK=

# Google OAuth client ID: Google sign-in accepts only access tokens issued to this ID
GOOGLE_CLIENT_ID=your_google_client_id

# Outgoing mail for OTP emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your_app_password

# Upload folders, relative to backend/
IMAGE_STORAGE=/uploads/images
AUDIO_STORAGE=/uploads/audio
