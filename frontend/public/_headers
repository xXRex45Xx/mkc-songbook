# Cloudflare Pages response headers (copied to dist by Vite).
# The service worker and the HTML must be revalidated on every check, or a
# deploy is not noticed; the hashed files can be cached for good.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate

/workbox-*.js
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable
