# Copy to backend/.env and fill in. Never commit backend/.env.

# Server port (no default in code; must be set)
PORT=4000
NODE_ENV=development

# MongoDB connection string
DB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>
# JWT signing secret: long random string
JWT_SECRET=change_me

# Number of reverse-proxy hops in front of the API (omit when none); used by auth rate limits
# TRUST_PROXY=1

# Comma-separated CORS origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Seeded super-admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_NAME=Admin
DEFAULT_ADMIN_PHOTO_LINK=

# Google OAuth client ID: Google sign-in accepts only access tokens issued to this ID
GOOGLE_CLIENT_ID=your_google_client_id

# Outgoing mail for OTP emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your_app_password

# Upload folders, relative to backend/
IMAGE_STORAGE=/uploads/images
AUDIO_STORAGE=/uploads/audio
