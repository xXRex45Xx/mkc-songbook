# Copy to frontend/.env and fill in. Never commit frontend/.env.

# Backend API origin
VITE_BACKEND_URL=http://localhost:4000
# This app's public origin (used in share links)
VITE_CLIENT_URL=http://localhost:5173
# Google OAuth client ID
VITE_GOOGLE_CLIENT_ID=your_google_client_id
# Cloudflare Turnstile site key (public); the login form shows the captcha when the server asks
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key
